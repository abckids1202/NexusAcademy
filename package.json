{
  "name": "wheelforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:e2e:cross-browser": "playwright test --config playwright.cross-browser.config.ts",
    "verify:supabase:staging": "node scripts/verify-supabase-staging.mjs",
    "verify:deployment:config": "node scripts/verify-static-deployment.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run test:coverage && npm run audit && npm run build && npm run verify:deployment:config && npm run test:e2e && npm run test:e2e:cloud"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
